# --- Required ---

# OpenRouter API key
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# --- Optional: models ---

# Council members (comma separated OpenRouter model identifiers) and the
# chairman that writes the final answer. Defaults are in backend/config.py.
# COUNCIL_MODELS=~openai/gpt-astra-latest,anthropic/claude-opus-5.5,qwen/qwen3.8-max-0902
# CHAIRMAN_MODEL=google/gemini-4-argon


# --- Optional: server / network ---

# Bind address. Loopback keeps the app reachable from this machine only.
# HOST=127.0.0.1
# PORT=8001

# Extra browser origins allowed to call the API, comma separated. Not needed
# when the backend serves frontend/dist itself (./start.sh) or with the Vite
# dev server on localhost:5173.
# ALLOWED_ORIGINS=http://localhost:3000

# Council runs allowed per minute, per client. 0 disables the limit.
# RATE_LIMIT_PER_MINUTE=10
