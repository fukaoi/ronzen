# --- Required ---

# OpenRouter API key
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# --- Optional: server / network ---

# Bind address. Keep this on loopback when publishing through a Cloudflare
# Tunnel: cloudflared runs on the same machine, so the port never needs to be
# reachable from the network.
# HOST=127.0.0.1
# PORT=8001

# Extra browser origins allowed to call the API, comma separated. Not needed
# when the backend serves frontend/dist itself (the default in production).
# ALLOWED_ORIGINS=https://council.example.com

# Council runs allowed per minute, per client. 0 disables the limit.
# RATE_LIMIT_PER_MINUTE=10
